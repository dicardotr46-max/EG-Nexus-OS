{
  "name": "eg-nexus-os",
  "version": "6.1.0",
  "description": "EG Nexus OS v6.1 — Personal Multi-Agent Operating System (PWA & Capacitor Android APK)",
  "private": true,
  "engines": {
    "node": ">=18.20.0"
  },
  "scripts": {
    "build": "node scripts/sync-www.js",
    "lint": "node scripts/lint.js",
    "test:syntax": "node scripts/check-syntax.js",
    "test:mutation": "npx stryker run stryker.config.json",
    "test": "jest",
    "audit:sync": "node scripts/sync-audit-report.js"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.8",
    "jest": "30.5.2",
    "jsdom": "31.0.0"
  },
  "overrides": {
    "glob": "14.0.4",
    "minimatch": "11.0.8",
    "uuid": "11.1.1",
    "deepmerge": "4.1.2"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.spec.js",
      "**/__tests__/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@exodus/bytes/(.*)$": "<rootDir>/__mocks__/@exodus/bytes/$1",
      "^@exodus/bytes$": "<rootDir>/__mocks__/@exodus/bytes/index.js"
    },
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "functions": 85,
        "branches": 80
      }
    }
  }
}
